# Staging Environment Configuration
NODE_ENV=staging

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=staging_password_change_me
DB_NAME=supply_chain_staging

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Application Configuration
PORT=3001
FRONTEND_URL=http://localhost

# JWT Configuration
JWT_SECRET=staging-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h

# External APIs (use test/sandbox endpoints)
MAPBOX_ACCESS_TOKEN=pk.test.staging
WEATHER_API_KEY=staging_weather_key

# Email Configuration (use test SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=staging_user
SMTP_PASS=staging_pass

# Monitoring
LOG_LEVEL=debug
SENTRY_DSN=staging_sentry_dsn