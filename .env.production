# Production Environment Configuration
NODE_ENV=production

# Database Configuration (use managed database service)
DB_HOST=your-production-db-host
DB_PORT=5432
DB_USERNAME=your-production-db-user
DB_PASSWORD=your-secure-production-password
DB_NAME=supply_chain_production

# Redis Configuration (use managed Redis service)
REDIS_HOST=your-production-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# Application Configuration
PORT=3001
FRONTEND_URL=https://your-domain.com

# JWT Configuration (use strong secrets)
JWT_SECRET=your-super-secure-jwt-secret-256-bits-minimum
JWT_EXPIRES_IN=24h

# External APIs (use production endpoints)
MAPBOX_ACCESS_TOKEN=pk.production.your_token
WEATHER_API_KEY=your_production_weather_key

# Email Configuration (use production SMTP)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-production-email
SMTP_PASS=your-production-email-password

# Monitoring
LOG_LEVEL=info
SENTRY_DSN=your-production-sentry-dsn